{
  "name": "pkguard",
  "version": "0.1.10",
  "description": "Audit package-manager security settings and advisories across monorepos and folders of projects. Supports npm, pnpm, yarn, bun, uv, cargo, and bundler.",
  "keywords": [
    "audit",
    "bun",
    "bundler",
    "cargo",
    "cli",
    "npm",
    "pnpm",
    "ruby",
    "rust",
    "security",
    "supply-chain",
    "uv",
    "yarn"
  ],
  "homepage": "https://pkguard.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmcpickle/pkguard.git"
  },
  "bin": {
    "pkguard": "./dist/pkguard.js"
  },
  "files": [
    "dist/pkguard.js",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "coverage:check": "bun scripts/check-coverage.ts",
    "coverage:write": "bun scripts/check-coverage.ts --write",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/main.ts --target=bun --banner '#!/usr/bin/env bun' --outfile dist/pkguard.js",
    "build:binary": "bun build ./src/main.ts --compile --outfile dist/pkguard",
    "prepublishOnly": "bun test && bun run build",
    "check": "ultracite check",
    "check:type-aware": "ultracite check --type-aware",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "release": "commit-and-tag-version",
    "release:notes": "bun scripts/release-notes.ts",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "site:check": "bun run --cwd site check"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "commit-and-tag-version": "^13.1.2",
    "eslint-plugin-crap": "0.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "ultracite": "7.10.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}} [skip publish]"
  }
}
