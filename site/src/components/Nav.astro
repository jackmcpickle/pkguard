---
import GitHubIcon from "@/components/GitHubIcon.astro";
import Logo from "@/components/Logo.astro";
import { GITHUB_URL } from "@/lib/site";

interface Props {
    current?: "home" | "docs";
}

const { current = "home" } = Astro.props;
---

<header
    class="nav-shell sticky top-0 z-20 border-b border-hairline"
>
    <div class="mx-auto flex h-16 max-w-[1400px] items-center gap-6 px-4 sm:px-6">
        <Logo />
        <div class="flex-1"></div>
        <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary">
            <a
                href="/docs"
                class:list={[
                    "text-sm leading-5",
                    current === "docs" ? "text-ink" : "text-body-mid hover:text-ink",
                ]}
                aria-current={current === "docs" ? "page" : undefined}
            >
                Docs
            </a>
            <GitHubIcon />
        </nav>
        <details class="relative sm:hidden">
            <summary
                class="flex min-h-9 list-none items-center justify-center rounded-full border border-stroke px-4 py-2 text-sm leading-5 text-ink"
            >
                Menu
            </summary>
            <div
                class="absolute right-0 mt-2 flex w-44 flex-col gap-3 rounded-sm border border-hairline bg-canvas-card p-4"
            >
                <a href="/docs" class="text-sm leading-5 text-ink">Docs</a>
                <a href={GITHUB_URL} class="text-sm leading-5 text-ink" rel="noopener" target="_blank">
                    GitHub
                </a>
            </div>
        </details>
    </div>
</header>

<style>
    summary::-webkit-details-marker {
        display: none;
    }
</style>
