---
import Button from "@/components/Button.astro";
import GitHubIcon from "@/components/GitHubIcon.astro";
import Logo from "@/components/Logo.astro";
import { GITHUB_URL } from "@/lib/site";

interface Props {
    current?: "home" | "docs";
}
---

<header
    class="sticky top-0 z-20 border-b border-hairline bg-canvas/88 backdrop-blur-[12px]"
>
    <div class="mx-auto flex max-w-[1200px] items-center gap-6 px-6 py-3">
        <Logo />
        <div class="flex-1"></div>
        <nav class="hidden items-center gap-3 sm:flex" aria-label="Primary">
            <Button href="/docs">Read the docs</Button>
            <Button href="/docs/install" variant="primary">Install</Button>
            <GitHubIcon />
        </nav>
        <details class="relative sm:hidden">
            <summary
                class="flex min-h-9 list-none items-center justify-center rounded-full border border-white/25 px-4 py-2 text-[14px] leading-5 text-ink"
            >
                Menu
            </summary>
            <div
                class="absolute right-0 mt-2 flex w-52 flex-col gap-3 rounded-sm border border-hairline bg-canvas-card p-4"
            >
                <Button href="/docs">Read the docs</Button>
                <Button href="/docs/install" variant="primary">Install</Button>
                <Button href={GITHUB_URL} external>GitHub</Button>
            </div>
        </details>
    </div>
</header>

<style>
    summary::-webkit-details-marker {
        display: none;
    }
</style>
