---
import {
    AUTHOR_NAME,
    AUTHOR_URL,
    GITHUB_URL,
    ISSUES_URL,
    LICENSE_NAME,
    LICENSE_URL,
    RELEASES_URL,
    SITE_NAME,
    SITE_UPDATED,
} from "@/lib/site";
---

<footer class="border-t border-hairline">
    <div
        class="mx-auto flex max-w-[1400px] flex-wrap items-start justify-between gap-8 px-4 py-12 sm:px-6"
    >
        <div class="flex max-w-[360px] flex-col gap-2">
            <p class="font-mono text-sm tracking-[1.4px] uppercase">{SITE_NAME}</p>
            <p class="text-sm leading-5 text-body-mid">
                Package-manager security audit for a folder of&nbsp;repos.
            </p>
            <p class="text-sm leading-5 text-body-mid">
                Free and open source under the
                <a href={LICENSE_URL} class="text-body underline" rel="noopener">
                    {LICENSE_NAME} license
                </a>. Built by
                <a href={AUTHOR_URL} class="text-body underline" rel="noopener">
                    {AUTHOR_NAME}
                </a>.
            </p>
            <p class="text-sm leading-5 text-body-mid">
                Updated <time datetime={SITE_UPDATED}>{SITE_UPDATED}</time>
            </p>
        </div>
        <div class="flex flex-wrap gap-10">
            <nav class="flex flex-col gap-2" aria-label="Docs">
                <p class="font-mono text-xs tracking-[1.2px] text-body-mid uppercase">Docs</p>
                <a href="/docs/install" class="text-sm leading-5 text-body">Install</a>
                <a href="/docs/commands/scan" class="text-sm leading-5 text-body">
                    Quick start
                </a>
                <a href="/docs/config" class="text-sm leading-5 text-body">Config</a>
            </nav>
            <nav class="flex flex-col gap-2" aria-label="Source">
                <p class="font-mono text-xs tracking-[1.2px] text-body-mid uppercase">
                    Source
                </p>
                <a
                    href={GITHUB_URL}
                    class="text-sm leading-5 text-body"
                    rel="noopener"
                    target="_blank">GitHub</a
                >
                <a
                    href={RELEASES_URL}
                    class="text-sm leading-5 text-body"
                    rel="noopener"
                    target="_blank">Releases</a
                >
                <a
                    href={ISSUES_URL}
                    class="text-sm leading-5 text-body"
                    rel="noopener"
                    target="_blank">Issues</a
                >
            </nav>
            <nav class="flex flex-col gap-2" aria-label="Project">
                <p class="font-mono text-xs tracking-[1.2px] text-body-mid uppercase">
                    Project
                </p>
                <a href="/about" class="text-sm leading-5 text-body">About</a>
                <a href="/about#contact" class="text-sm leading-5 text-body">Contact</a>
                <a href="/#faq" class="text-sm leading-5 text-body">FAQ</a>
            </nav>
        </div>
    </div>
</footer>
