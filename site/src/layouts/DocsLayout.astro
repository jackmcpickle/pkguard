---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DocsEdit, DocsNav, DocsToc, type DocsTocItem } from "@/modules/docs";

interface Props {
    title: string;
    description?: string;
    current: string;
    toc?: readonly DocsTocItem[];
}

const { title, description, current, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} current="docs">
    <div
        class="mx-auto grid max-w-[1200px] grid-cols-1 items-start gap-12 px-6 py-12 lg:grid-cols-[220px_minmax(0,1fr)] xl:grid-cols-[220px_minmax(0,1fr)_200px]"
    >
        <aside class="lg:sticky lg:top-24">
            <DocsNav current={current} />
        </aside>
        <article class="min-w-0">
            <slot />
            <DocsEdit />
        </article>
        {
            toc.length > 0 && (
                <aside class="hidden xl:sticky xl:top-24 xl:block">
                    <DocsToc items={toc} />
                </aside>
            )
        }
    </div>
</BaseLayout>
