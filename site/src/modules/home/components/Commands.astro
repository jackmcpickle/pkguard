---
import { COMMANDS, commandSynopsis } from "@cli/cli-catalog";
import { APP_NAME } from "@cli/app-name";
---

<section class="border-t border-hairline px-6 py-16 md:px-8">
  <div class="mx-auto max-w-[1200px]">
    <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-ink uppercase">
      Commands
    </p>
    <h2
      class="mt-4 max-w-[16ch] text-[32px] leading-9 tracking-[-0.6px] md:text-[48px] md:leading-[48px] md:tracking-[-1.2px]"
    >
      The same catalog as {APP_NAME} --help.
    </h2>
    <ul class="mt-12 grid gap-4 md:grid-cols-2">
      {
        COMMANDS.map((command) => (
          <li class="rounded-sm border border-hairline bg-canvas-card p-6">
            <a href={`/docs/commands/${command.name}`} class="block">
              <p class="font-mono text-[14px] leading-5 text-ink">
                {APP_NAME} {commandSynopsis(command)}
              </p>
              <p class="mt-3 text-[16px] leading-6 text-body">{command.summary}</p>
              <p class="mt-6 text-[14px] leading-5 text-body-mid">
                {command.flags.length === 1
                  ? "1 option"
                  : `${command.flags.length} options`}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
