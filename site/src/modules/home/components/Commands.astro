---
import { APP_NAME, COMMANDS, commandSynopsis } from "@/lib/catalog";
---

<section class="border-t border-hairline">
    <div class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
        <p class="font-mono text-sm text-body-mid">{APP_NAME} --help</p>
        <ul class="mt-8 flex flex-col">
            {
                COMMANDS.map((command) => (
                    <li class="border-t border-hairline">
                        <a
                            href={`/docs/commands/${command.name}`}
                            class="flex flex-col gap-3 py-8 hover:text-ink"
                        >
                            <h2 class="font-mono text-2xl leading-8 tracking-tight md:text-3xl">
                                {APP_NAME} {commandSynopsis(command)}
                            </h2>
                            <p class="max-w-[52ch] text-base leading-6 text-body">
                                {command.summary}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
