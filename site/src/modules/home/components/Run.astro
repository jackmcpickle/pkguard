---
const steps = [
    {
        n: "01",
        title: "Discover roots",
        body: "Find each package-manager root under the path you pass.",
    },
    {
        n: "02",
        title: "Read settings",
        body: "Parse committed config files. A missing binary does not skip this step.",
    },
    {
        n: "03",
        title: "Run native audit",
        body: "If the binary is on PATH, shell out to that manager's own audit command.",
    },
] as const;
---

<section class="border-t border-hairline">
    <div class="mx-auto max-w-[1200px] px-6 py-16">
        <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-body-mid uppercase">
            How a run works
        </p>
        <h2
            class="mt-4 text-[32px] leading-9 font-normal tracking-[-0.6px] md:text-[48px] md:leading-[48px] md:tracking-[-1.2px]"
        >
            Settings first. Advisories second.
        </h2>
        <ol class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-[repeat(auto-fit,minmax(280px,1fr))]">
            {
                steps.map((step) => (
                    <li class="flex flex-col gap-3 rounded-sm border border-hairline bg-canvas-card p-6">
                        <p class="font-mono text-[12px] leading-4 tracking-[1.2px] text-accent-sunset">
                            {step.n}
                        </p>
                        <h3 class="text-[20px] leading-7">{step.title}</h3>
                        <p class="text-[14px] leading-5 text-body-mid">{step.body}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
