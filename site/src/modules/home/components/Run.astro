---
const steps = [
    {
        title: "Find each root",
        body: "Walk the path you pass and stop at every package-manager root.",
    },
    {
        title: "Read committed settings",
        body: "Parse the config files in git. A missing binary does not skip this.",
    },
    {
        title: "Run the native audit",
        body: "If the manager binary is on PATH, pkguard shells out to that manager's own audit command.",
    },
] as const;
---

<section class="border-t border-hairline bg-canvas-soft">
    <div
        class="mx-auto grid max-w-[1400px] gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start"
    >
        <h2
            class="text-3xl leading-tight font-normal tracking-tight md:text-5xl md:leading-[1.1]"
        >
            Settings first. Advisories&nbsp;second.
        </h2>
        <ol class="flex flex-col">
            {
                steps.map((step) => (
                    <li class="border-l border-hairline py-5 pl-6 first:pt-0 last:pb-0">
                        <h3 class="text-xl leading-7">{step.title}</h3>
                        <p class="mt-2 max-w-[48ch] text-sm leading-6 text-body-mid">
                            {step.body}
                        </p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
