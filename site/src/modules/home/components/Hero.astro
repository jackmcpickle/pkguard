---
import CopyCommand from "@/components/CopyCommand.astro";
import { APP_NAME } from "@/lib/catalog";
---

<section class="px-6 pt-24 pb-16">
    <div class="mx-auto max-w-[1200px]">
        <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-body-mid uppercase">
            Package-manager security audit
        </p>
        <h1
            class="mt-6 max-w-[1000px] text-[48px] leading-[48px] font-normal tracking-[-1.2px] text-pretty md:text-[96px] md:leading-[96px] md:tracking-[-2.4px]"
        >
            Audit every package manager in the&nbsp;tree.
        </h1>
        <p class="mt-8 max-w-[640px] text-[18px] leading-7 text-body">
            Walk a folder of repos, read committed settings, and run each manager's native
            audit. One read-only command, one Rust binary, one&nbsp;report.
        </p>
        <div class="mt-12">
            <CopyCommand command={`${APP_NAME} scan ~/code`} />
        </div>
    </div>
</section>
