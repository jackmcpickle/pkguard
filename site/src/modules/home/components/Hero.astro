---
import CopyCommand from "@/components/CopyCommand.astro";
import { APP_NAME } from "@/lib/catalog";
import { BREW_INSTALL } from "@/lib/site";
---

<section class="px-4 pt-16 pb-12 sm:px-6">
    <div class="mx-auto grid max-w-[1400px] items-stretch gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="rise max-w-[34rem]">
            <h1
                class="text-4xl leading-[1.1] font-normal tracking-tight text-pretty md:text-5xl"
            >
                Audit every package manager in the&nbsp;tree.
            </h1>
            <p class="mt-6 max-w-[46ch] text-lg leading-7 text-body">
                pkguard is a free command-line tool. It scans a folder full of repos. It
                finds every package manager, reads the settings you keep in git, and runs
                each manager's own audit. One command covers npm, pnpm, yarn, bun, uv,
                cargo, composer, and&nbsp;bundler.
            </p>
            <p class="mt-4 max-w-[46ch] text-base leading-6 text-body-mid">
                A scan never writes files. Add <code class="font-mono">--fix</code> when you
                want it to repair the unsafe settings it&nbsp;finds.
            </p>
            <div class="mt-10 flex flex-col gap-3">
                <CopyCommand command={BREW_INSTALL} />
                <CopyCommand command={`${APP_NAME} scan ~/code`} />
            </div>
        </div>
        <div class="rise-late overflow-hidden rounded-sm bg-canvas-card">
            <img
                src="/images/hero-tree.jpg"
                alt="A dark metal tree with orange electric veins and packages hanging from the branches."
                width="1536"
                height="968"
                fetchpriority="high"
                decoding="async"
                class="aspect-[1536/968] h-full w-full object-cover lg:min-h-[22rem]"
            />
        </div>
    </div>
</section>
