---
import Button from "@/components/Button.astro";
---

<section class="px-6 pt-16 pb-20 md:px-8 md:pt-20 md:pb-24">
  <div class="mx-auto max-w-[1200px]">
    <h1
      class="max-w-[18ch] text-[48px] leading-[48px] tracking-[-1.2px] text-ink md:text-[96px] md:leading-[96px] md:tracking-[-2.4px]"
    >
      Audit every package manager in the&nbsp;tree.
    </h1>
    <p class="mt-6 max-w-[36ch] text-[18px] leading-7 text-body">
      Walk a folder of repos, read settings, and run each manager's native&nbsp;audit.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/docs/install" variant="primary">Install</Button>
      <Button href="/docs">Read the docs</Button>
    </div>
  </div>
</section>
