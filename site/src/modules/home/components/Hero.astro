---
import CopyCommand from "@/components/CopyCommand.astro";
import { APP_NAME } from "@/lib/catalog";
---

<section class="px-4 pt-16 pb-12 sm:px-6">
    <div class="mx-auto grid max-w-[1400px] items-stretch gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="rise max-w-[34rem]">
            <h1
                class="text-4xl leading-[1.1] font-normal tracking-tight text-pretty md:text-5xl"
            >
                Audit every package manager in the&nbsp;tree.
            </h1>
            <p class="mt-6 max-w-[36ch] text-lg leading-7 text-body">
                Finds each package-manager root, reads committed settings, and runs that
                manager's own&nbsp;audit.
            </p>
            <div class="mt-10">
                <CopyCommand command={`${APP_NAME} scan ~/code`} />
            </div>
        </div>
        <div class="rise-late overflow-hidden rounded-sm bg-canvas-card">
            <img
                src="/images/hero-tree.jpg"
                alt="A dark metal tree with orange electric veins and packages hanging from the branches."
                width="1536"
                height="968"
                fetchpriority="high"
                decoding="async"
                class="aspect-[1536/968] h-full w-full object-cover lg:min-h-[22rem]"
            />
        </div>
    </div>
</section>
