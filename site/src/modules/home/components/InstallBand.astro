---
import Button from "@/components/Button.astro";
import { RELEASES_URL } from "@/lib/site";
---

<section class="border-t border-hairline bg-canvas-soft">
    <div
        class="mx-auto grid max-w-[1400px] items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16"
    >
        <div class="overflow-hidden rounded-sm bg-canvas-card">
            <img
                src="/images/install-hardware.jpg"
                alt="Dark anodized metal plate with one orange hex screw in raking light."
                width="1536"
                height="968"
                loading="lazy"
                decoding="async"
                class="aspect-[1536/968] h-full w-full object-cover"
            />
        </div>
        <div class="max-w-[520px]">
            <h2
                class="text-3xl leading-tight font-normal tracking-tight md:text-5xl md:leading-[1.1]"
            >
                Install with cargo
            </h2>
            <p class="mt-6 text-base leading-6 text-body">
                Homebrew and release binaries are not published yet.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
                <Button href="/docs/install" variant="primary" size="lg">
                    Install guide
                </Button>
                <Button href={RELEASES_URL} size="lg" external>Releases</Button>
            </div>
        </div>
    </div>
</section>
