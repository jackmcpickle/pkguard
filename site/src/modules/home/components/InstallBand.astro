---
import Button from "@/components/Button.astro";
import { RELEASES_URL } from "@/lib/site";
---

<section class="border-t border-hairline">
    <div
        class="mx-auto flex max-w-[1200px] flex-wrap items-end justify-between gap-12 px-6 py-16"
    >
        <div class="max-w-[640px]">
            <p
                class="font-mono text-[14px] leading-5 tracking-[1.4px] text-body-mid uppercase"
            >
                Install
            </p>
            <h2
                class="mt-4 text-[48px] leading-[48px] font-normal tracking-[-1.2px] md:text-[72px] md:leading-[72px] md:tracking-[-1.8px]"
            >
                One Rust binary.
            </h2>
            <p class="mt-6 text-[16px] leading-6 text-body">
                Install with cargo today. A Homebrew tap and prebuilt release binaries land
                with the distribution&nbsp;cutover.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <Button href="/docs/install" variant="primary" size="lg">
                Install guide
            </Button>
            <Button href={RELEASES_URL} size="lg" external>Releases</Button>
        </div>
    </div>
</section>
