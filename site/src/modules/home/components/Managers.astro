---
import { MANAGER_DOCS } from "@/lib/catalog";

const LANGUAGE_BY_MANAGER: Record<string, string> = {
    bun: "JavaScript",
    bundler: "Ruby",
    cargo: "Rust",
    composer: "PHP",
    npm: "JavaScript",
    pip: "Python",
    pipenv: "Python",
    pnpm: "JavaScript",
    poetry: "Python",
    uv: "Python",
    yarn: "JavaScript",
};

const LANGUAGE_ORDER = ["JavaScript", "Python", "Rust", "PHP", "Ruby"] as const;

const grouped = LANGUAGE_ORDER.map((language) => ({
    language,
    managers: MANAGER_DOCS.filter(
        (manager) => LANGUAGE_BY_MANAGER[manager.name] === language,
    ),
})).filter((group) => group.managers.length > 0);

const leftover = MANAGER_DOCS.filter(
    (manager) => LANGUAGE_BY_MANAGER[manager.name] === undefined,
);
const groups =
    leftover.length === 0
        ? grouped
        : [...grouped, { language: "Other", managers: leftover }];

const flaggedNames = MANAGER_DOCS.filter(
    (manager) => manager.kind === "python-legacy",
).map((manager) => manager.name);
---

<section class="border-t border-hairline">
    <div class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
        <h2
            class="max-w-[18ch] text-3xl leading-tight font-normal tracking-tight md:text-5xl md:leading-[1.1]"
        >
            JavaScript, Python, Rust, PHP, Ruby.
        </h2>
        <p class="mt-6 max-w-[48ch] text-base leading-6 text-body">
            The package managers pkguard looks for under each root.
        </p>
        <ul class="mt-12 flex flex-col">
            {
                groups.map((group) => (
                    <li class="grid grid-cols-1 gap-4 border-t border-hairline py-8 md:grid-cols-[10rem_minmax(0,1fr)] md:items-baseline md:gap-10">
                        <h3 class="text-lg leading-7 text-ink">{group.language}</h3>
                        <ul class="flex flex-wrap gap-x-8 gap-y-3">
                            {group.managers.map((manager) => (
                                <li
                                    class:list={[
                                        "font-mono text-base leading-6",
                                        manager.kind === "python-legacy"
                                            ? "text-body-mid"
                                            : "text-ink",
                                    ]}
                                >
                                    {manager.name}
                                </li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
        <p class="mt-2 text-sm leading-6 text-body-mid">
            {flaggedNames.join(", ")} are detected only.
            <a href="/docs/managers" class="ml-2 text-ink underline">
                Manager profiles
            </a>
        </p>
    </div>
</section>
