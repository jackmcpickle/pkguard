---
import {
    SAMPLE_COMMAND,
    SAMPLE_PROJECTS,
    SAMPLE_SUMMARY,
    SEVERITY_CLASS,
} from "../sample-run";
---

<section
    id="output"
    class="border-t border-hairline bg-canvas-soft"
    aria-labelledby="output-heading"
>
    <div class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
        <h2
            id="output-heading"
            class="max-w-[20ch] text-3xl leading-tight font-normal tracking-tight md:text-5xl md:leading-[1.1]"
        >
            What a run looks&nbsp;like.
        </h2>
        <p class="mt-6 max-w-[52ch] text-base leading-6 text-body">
            A real scan of one folder holding a bun app and a uv service. Settings come
            first, then the advisories from each manager's own audit. The last line is
            the whole run.
        </p>

        <p class="mt-10 font-mono text-sm text-body-mid">$ {SAMPLE_COMMAND}</p>

        <div class="mt-8 flex flex-col gap-12">
            {
                SAMPLE_PROJECTS.map((project) => (
                    <article>
                        <h3 class="flex flex-wrap items-baseline gap-x-4 font-mono text-xl leading-8 tracking-tight text-ink">
                            {project.name}
                            <span class="text-sm text-body-mid">{project.headline}</span>
                        </h3>
                        <p class="font-mono text-xs tracking-[1.2px] text-body-mid uppercase">
                            preset {project.preset}
                        </p>

                        {project.sections.map((section) => (
                            <div class="mt-8">
                                <h4 class="font-mono text-sm text-body">
                                    {section.title} ({section.count})
                                </h4>

                                {section.findings.length === 0 ? (
                                    <p class="mt-2 font-mono text-sm text-body-mid">
                                        {section.empty}
                                    </p>
                                ) : (
                                    <ul class="mt-3 flex flex-col">
                                        <li
                                            class="grid gap-x-6 gap-y-1 py-2 font-mono text-xs tracking-[1.2px] text-body-mid uppercase sm:grid-cols-[18rem_minmax(0,1fr)]"
                                            aria-hidden="true"
                                        >
                                            <span class="flex items-baseline gap-3">
                                                <span class="w-24 shrink-0">Severity</span>
                                                <span>Code</span>
                                            </span>
                                            <span class="hidden sm:block">Detail</span>
                                        </li>
                                        {section.findings.map((finding) => (
                                            <li class="grid gap-x-6 gap-y-1 border-t border-hairline py-3 sm:grid-cols-[18rem_minmax(0,1fr)]">
                                                <span class="flex items-baseline gap-3">
                                                    <span
                                                        class:list={[
                                                            "w-24 shrink-0 font-mono text-xs tracking-[1.2px] uppercase",
                                                            SEVERITY_CLASS[finding.severity],
                                                        ]}
                                                    >
                                                        {finding.severity}
                                                    </span>
                                                    <span class="font-mono text-xs break-all text-body-mid">
                                                        {finding.code}
                                                    </span>
                                                </span>
                                                <span class="text-sm leading-6 text-body">
                                                    {finding.pkg && (
                                                        <span class="font-mono text-ink">
                                                            {finding.pkg}
                                                        </span>
                                                    )}
                                                    {finding.pkg ? " · " : ""}
                                                    {finding.detail}
                                                </span>
                                            </li>
                                        ))}
                                        {section.omitted && (
                                            <li class="border-t border-hairline py-3 text-sm leading-6 text-body-mid">
                                                and {section.omitted} more advisories
                                            </li>
                                        )}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </article>
                ))
            }
        </div>

        <p
            class="mt-12 border-t border-hairline pt-6 font-mono text-sm leading-6 text-ink"
        >
            {SAMPLE_SUMMARY}
        </p>
        <p class="mt-4 max-w-[52ch] text-sm leading-6 text-body-mid">
            Exit <code class="font-mono">1</code> means a policy failure. See the <a
                href="/docs/commands/scan"
                class="text-ink underline">scan docs</a
            > for every exit code. The uv rows all read <code class="font-mono"
                >info</code
            > because uv publishes no severity with an advisory.
        </p>
    </div>
</section>
