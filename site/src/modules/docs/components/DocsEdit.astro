---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<div class="mt-12 border-t border-hairline pt-12">
    <a
        href={href}
        class="inline-flex items-center justify-center rounded-full border border-stroke px-4 py-2 text-sm leading-5 text-ink"
        rel="noopener"
        target="_blank"
    >
        Edit this page on GitHub
    </a>
</div>
