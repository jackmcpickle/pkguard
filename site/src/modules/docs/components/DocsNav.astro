---
import { DOCS_NAV } from "../nav";

interface Props {
    current: string;
}

const { current } = Astro.props;
---

<nav class="flex flex-col gap-8" aria-label="Docs">
    {
        DOCS_NAV.map((group) => (
            <div class="flex flex-col gap-3">
                <p class="font-mono text-[12px] leading-4 tracking-[1.2px] text-body-mid uppercase">
                    {group.title}
                </p>
                {group.items.map((link) => {
                    const isCurrent = current === link.href;
                    return (
                        <a
                            href={link.href}
                            class:list={[
                                "border-l py-0 pl-3 text-[14px] leading-5",
                                isCurrent
                                    ? "border-accent-sunset text-ink"
                                    : "border-hairline text-body-mid hover:text-ink",
                            ]}
                            aria-current={isCurrent ? "page" : undefined}
                        >
                            {link.label}
                        </a>
                    );
                })}
            </div>
        ))
    }
</nav>
