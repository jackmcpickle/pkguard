---
import { DOCS_LINKS } from "../nav";

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav aria-label="Docs">
  <p class="font-mono text-[12px] leading-4 tracking-[1.2px] text-body-mid uppercase">
    Docs
  </p>
  <ul class="mt-4 flex flex-col gap-3">
    {
      DOCS_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "font-mono text-[14px] leading-5",
              current === link.href ? "text-ink" : "text-body",
            ]}
            aria-current={current === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
