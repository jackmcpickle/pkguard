{
  "appName": "pkguard",
  "version": "1.1.4",
  "configFileName": ".pkguard.toml",
  "cacheEnvVar": "PKGUARD_CACHE_DIR",
  "userConfigPaths": {
    "linux": "~/.config/pkguard/config.toml",
    "macos": "~/Library/Application Support/dev.pkguard.pkguard/config.toml"
  },
  "configSearchOrder": "Reads the user config, then .pkguard.toml at the scan root and in each repo. Closer wins; flags win over files.",
  "commands": [
    {
      "name": "scan",
      "aliases": [
        "audit"
      ],
      "summary": "Audit one directory tree. Read-only unless `--fix` is passed",
      "arguments": [
        {
          "name": "path",
          "required": false,
          "description": "Directory to scan (defaults to the current directory)"
        }
      ],
      "flags": [
        {
          "names": [
            "--preset"
          ],
          "value": "relaxed|standard|strict",
          "description": "Policy preset"
        },
        {
          "names": [
            "--jobs"
          ],
          "value": "jobs",
          "description": "Max concurrent audits (defaults to min(cpus*2, 16))"
        },
        {
          "names": [
            "--format"
          ],
          "value": "human|json",
          "description": "Output format"
        },
        {
          "names": [
            "--refresh"
          ],
          "value": null,
          "description": "Ignore cached advisory results for this run and re-fetch"
        },
        {
          "names": [
            "--no-cache"
          ],
          "value": null,
          "description": "Disable the advisory cache entirely (no reads, no writes)"
        },
        {
          "names": [
            "-q",
            "--quiet"
          ],
          "value": null,
          "description": "Suppress progress output"
        },
        {
          "names": [
            "--fix"
          ],
          "value": null,
          "description": "Write the safe settings into each manager's config file"
        },
        {
          "names": [
            "--force"
          ],
          "value": null,
          "description": "Allow `--fix` on a dirty git tree"
        },
        {
          "names": [
            "--dry-run"
          ],
          "value": null,
          "description": "With `--fix`, show the changes and write nothing"
        },
        {
          "names": [
            "--no-audit"
          ],
          "value": null,
          "description": "Skip every live package-manager audit (offline)"
        },
        {
          "names": [
            "-h",
            "--help"
          ],
          "value": null,
          "description": "Print help"
        }
      ]
    },
    {
      "name": "init",
      "aliases": [],
      "summary": "Write a starter config file",
      "arguments": [],
      "flags": [
        {
          "names": [
            "--local"
          ],
          "value": null,
          "description": "Write `.pkguard.toml` in the current directory instead of the user config"
        },
        {
          "names": [
            "--force"
          ],
          "value": null,
          "description": "Overwrite an existing file"
        },
        {
          "names": [
            "-h",
            "--help"
          ],
          "value": null,
          "description": "Print help"
        }
      ]
    }
  ],
  "managers": [
    {
      "name": "npm",
      "kind": "config",
      "binary": "npm",
      "auditArgv": [
        "npm",
        "audit",
        "--json"
      ],
      "lockfileNames": [
        "package-lock.json"
      ],
      "configNames": [
        ".npmrc"
      ],
      "writeConfigName": ".npmrc",
      "ported": true
    },
    {
      "name": "pnpm",
      "kind": "config",
      "binary": "pnpm",
      "auditArgv": [
        "pnpm",
        "audit",
        "--json"
      ],
      "lockfileNames": [
        "pnpm-lock.yaml"
      ],
      "configNames": [
        "pnpm-workspace.yaml"
      ],
      "writeConfigName": "pnpm-workspace.yaml",
      "ported": true
    },
    {
      "name": "yarn",
      "kind": "config",
      "binary": "yarn",
      "auditArgv": [
        "yarn",
        "npm",
        "audit",
        "--json"
      ],
      "lockfileNames": [
        "yarn.lock"
      ],
      "configNames": [
        ".yarnrc.yml"
      ],
      "writeConfigName": ".yarnrc.yml",
      "ported": true
    },
    {
      "name": "bun",
      "kind": "config",
      "binary": "bun",
      "auditArgv": [
        "bun",
        "audit",
        "--json"
      ],
      "lockfileNames": [
        "bun.lock",
        "bun.lockb"
      ],
      "configNames": [
        "bunfig.toml"
      ],
      "writeConfigName": "bunfig.toml",
      "ported": true
    },
    {
      "name": "uv",
      "kind": "config",
      "binary": "uv",
      "auditArgv": [
        "uv",
        "audit",
        "--output-format",
        "json",
        "--frozen"
      ],
      "lockfileNames": [
        "uv.lock"
      ],
      "configNames": [
        "uv.toml",
        "pyproject.toml"
      ],
      "writeConfigName": null,
      "ported": true
    },
    {
      "name": "cargo",
      "kind": "config",
      "binary": "cargo",
      "auditArgv": [
        "cargo",
        "audit",
        "--json"
      ],
      "lockfileNames": [
        "Cargo.lock"
      ],
      "configNames": [
        ".cargo/config.toml",
        ".cargo/config"
      ],
      "writeConfigName": ".cargo/config.toml",
      "ported": true
    },
    {
      "name": "composer",
      "kind": "config",
      "binary": "composer",
      "auditArgv": [
        "composer",
        "audit",
        "--format",
        "json",
        "--locked"
      ],
      "lockfileNames": [
        "composer.lock"
      ],
      "configNames": [
        "composer.json"
      ],
      "writeConfigName": "composer.json",
      "ported": true
    },
    {
      "name": "poetry",
      "kind": "python-legacy",
      "binary": null,
      "auditArgv": null,
      "lockfileNames": [],
      "configNames": [],
      "writeConfigName": null,
      "ported": false
    },
    {
      "name": "pip",
      "kind": "python-legacy",
      "binary": null,
      "auditArgv": null,
      "lockfileNames": [],
      "configNames": [],
      "writeConfigName": null,
      "ported": false
    },
    {
      "name": "pipenv",
      "kind": "python-legacy",
      "binary": null,
      "auditArgv": null,
      "lockfileNames": [],
      "configNames": [],
      "writeConfigName": null,
      "ported": false
    },
    {
      "name": "bundler",
      "kind": "config",
      "binary": "bundle-audit",
      "auditArgv": [
        "bundle-audit",
        "check",
        "--format",
        "json"
      ],
      "lockfileNames": [
        "Gemfile.lock"
      ],
      "configNames": [
        ".bundle/config"
      ],
      "writeConfigName": ".bundle/config",
      "ported": true
    }
  ],
  "presetDefaults": {
    "relaxed": {
      "auditLevel": "critical",
      "ignoreScripts": false,
      "minReleaseAgeDays": 0,
      "requireLockfile": true,
      "requirePmPin": false
    },
    "standard": {
      "auditLevel": "high",
      "ignoreScripts": true,
      "minReleaseAgeDays": 1,
      "requireLockfile": true,
      "requirePmPin": true
    },
    "strict": {
      "auditLevel": "moderate",
      "ignoreScripts": true,
      "minReleaseAgeDays": 14,
      "requireLockfile": true,
      "requirePmPin": true
    }
  },
  "agentic": [
    {
      "code": "cache.path-committed",
      "title": "Committed store or cache path",
      "description": "A project file pins storeDir, cache, cacheFolder, or install.cache.dir.",
      "caveat": "Shared caches belong in user config. A committed home path breaks CI and other agents. Apply only unsets an in-repo path — it never writes ~/…/store."
    },
    {
      "code": "agentic.cache-disabled",
      "title": "Global cache disabled",
      "description": "yarn enableGlobalCache is false.",
      "caveat": "Leave enableGlobalCache true unless the team vendors .yarn/cache (Zero-Installs)."
    },
    {
      "code": "overrides.present",
      "title": "Version override precedent",
      "description": "overrides, resolutions, or pnpm workspace overrides force a version the manifest does not show.",
      "caveat": "The next agent will copy this instead of upgrading. Presence is the warning; apply never deletes a pin."
    },
    {
      "code": "overrides.legacy-location",
      "title": "Legacy pnpm overrides location",
      "description": "package.json#pnpm.overrides on pnpm 11 or later.",
      "caveat": "pnpm 11 ignores package.json#pnpm. Apply can move the map to pnpm-workspace.yaml only."
    },
    {
      "code": "layout.shamefully-hoist",
      "title": "Shameful hoist",
      "description": "pnpm shamefullyHoist is true, or publicHoistPattern contains *.",
      "caveat": "Makes require() succeed for undeclared deps. The next isolated install breaks."
    },
    {
      "code": "layout.pnp",
      "title": "Plug'n'Play linker",
      "description": "yarn or pnpm nodeLinker is pnp (yarn's default).",
      "caveat": "Most agents assume node_modules and run node, not yarn node. Apply to node-modules is opt-in because it changes the team layout."
    }
  ]
}
