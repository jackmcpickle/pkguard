---
import { APP_NAME } from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { DocsBody, DocsHeader } from "@/modules/docs";
---

<DocsLayout
    title={`Docs - ${APP_NAME}`}
    description="Install pkguard, then scan a folder of package-manager roots."
    current="/docs"
>
    <DocsHeader
        eyebrow="Overview"
        title="Scan a folder of package-manager roots."
        lead={`${APP_NAME} scan is read-only unless you pass --fix. Flags on the scan page come from ${APP_NAME} dump-catalog.`}
    />
    <DocsBody>
        Start with
        <a href="/docs/commands/scan" class="text-ink underline">
            {APP_NAME} scan
        </a>.
    </DocsBody>
</DocsLayout>
