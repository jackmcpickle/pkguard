---
import { COMMANDS, commandSynopsis } from "@cli/cli-catalog";
import { APP_NAME } from "@cli/app-name";
import { MANAGER_DOCS } from "@cli/manager-docs";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    DocsBody,
    DocsHeader,
    KeyValue,
    SectionHeading,
} from "@/modules/docs";

const configCount = MANAGER_DOCS.filter((manager) => manager.kind === "config")
    .length;
---

<DocsLayout
    title={`Docs — ${APP_NAME}`}
    description="Install mailclad, then audit a folder of package-manager roots."
    current="/docs"
    toc={[{ id: "commands", label: "Commands" }]}
>
    <DocsHeader
        eyebrow="Overview"
        title={`${APP_NAME} walks a folder of repos and audits each package-manager root.`}
        lead={`It does not write files unless you pass an apply flag. ${configCount} managers share the same path. Commands and flags on these pages come from the CLI catalog in source, so a flag change updates the docs.`}
    />
    <SectionHeading id="commands">Commands</SectionHeading>
    <DocsBody>
        The same catalog as <code class="font-mono text-ink">{APP_NAME} --help</code>.
    </DocsBody>
    <KeyValue
        rows={COMMANDS.map((command) => ({
            href: `/docs/commands/${command.name}`,
            key: `${APP_NAME} ${commandSynopsis(command)}`,
            value: command.summary,
        }))}
    />
</DocsLayout>
