---
import { AGENTIC_CATALOG, APP_NAME } from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    DocsBody,
    DocsHeader,
    KeyValue,
    Note,
    SectionHeading,
} from "@/modules/docs";
---

<DocsLayout
    title={`Agentic checks - ${APP_NAME}`}
    description="Agentic findings pkguard warns about by default."
    current="/docs/agentic"
    toc={[{ id: "catalog", label: "Catalog" }]}
>
    <DocsHeader
        eyebrow="Agentic checks"
        title="Agentic finding codes"
        lead="Reported by default. Turn off with [agentic] enabled = false in config. --fix writes settings only. [agentic] apply stays off."
    />
    <SectionHeading id="catalog">Catalog</SectionHeading>
    <DocsBody>
        Taken from the binary via
        <code class="font-mono text-ink">{APP_NAME} dump-catalog</code>. The codes are
        part of the finding-code contract carried over from the previous build.
    </DocsBody>
    <KeyValue
        rows={AGENTIC_CATALOG.map((check) => ({
            key: check.code,
            value: `${check.title}. ${check.description}`,
            note: check.caveat,
        }))}
    />
    <Note>
        scan without --fix is read-only. --fix writes settings files only. It never
        writes a home-dir store or deletes overrides. [agentic] apply is still off.
    </Note>
</DocsLayout>
