---
import { AGENTIC_CATALOG } from "@cli/agentic-catalog";
import { APP_NAME } from "@cli/app-name";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    DocsBody,
    DocsHeader,
    KeyValue,
    Note,
    SectionHeading,
} from "@/modules/docs";
---

<DocsLayout
    title={`Agentic checks — ${APP_NAME}`}
    description={`Agentic findings ${APP_NAME} warns about by default.`}
    current="/docs/agentic"
    toc={[{ id: "catalog", label: "Catalog" }]}
>
    <DocsHeader
        eyebrow="Guides / agentic"
        title="Codes from the agentic catalog."
        lead="Warned at info by default. --apply does not write them unless applyAgentic is on. --apply-agentic writes only the safe edits."
    />
    <SectionHeading id="catalog">Catalog</SectionHeading>
    <DocsBody>
        Source: <code class="font-mono text-ink">src/agentic-catalog.ts</code>.
    </DocsBody>
    <KeyValue
        rows={AGENTIC_CATALOG.map((check) => ({
            key: check.code,
            value: `${check.title}. ${check.description}`,
            note: check.caveat,
        }))}
    />
    <Note>
        Apply is off unless applyAgentic is on. --apply-agentic writes only the safe
        edits. Never writes a home-dir store or deletes overrides.
    </Note>
</DocsLayout>
