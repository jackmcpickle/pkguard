---
import { APP_NAME } from "@cli/app-name";
import { PRESET_DEFAULTS } from "@cli/preset-defaults";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { DocsBody, DocsHeader, DocsPanel, SectionHeading } from "@/modules/docs";

const presets = Object.entries(PRESET_DEFAULTS);
const keys = [
    "auditLevel",
    "ignoreScripts",
    "minReleaseAgeDays",
    "requireLockfile",
    "requirePmPin",
] as const;
---

<DocsLayout
    title={`Presets — ${APP_NAME}`}
    description="relaxed, standard, and strict policy defaults from the CLI."
    current="/docs/presets"
    toc={[{ id: "gates", label: "Three gates" }]}
>
    <DocsHeader
        eyebrow="Guides / presets"
        title="Three gates, one table in source."
        lead="Values come from src/preset-defaults.ts. Pass --preset relaxed|standard|strict."
    />
    <SectionHeading id="gates">Three gates</SectionHeading>
    <DocsBody>
        Pass <code class="font-mono text-ink">--preset relaxed|standard|strict</code> to
        pick a gate.
    </DocsBody>
    <DocsPanel>
        <table class="w-full min-w-[560px] text-left text-[14px] leading-5">
            <thead>
                <tr
                    class="border-b border-hairline font-mono text-[12px] tracking-[1.2px] text-body-mid uppercase"
                >
                    <th class="px-6 py-4 font-normal">Key</th>
                    {
                        presets.map(([name]) => (
                            <th class="px-6 py-4 font-normal">{name}</th>
                        ))
                    }
                </tr>
            </thead>
            <tbody>
                {
                    keys.map((key) => (
                        <tr class="border-b border-hairline last:border-b-0">
                            <td class="px-6 py-4 font-mono text-ink">{key}</td>
                            {presets.map(([, preset]) => (
                                <td class="px-6 py-4 font-mono text-body">
                                    {String(preset[key])}
                                </td>
                            ))}
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </DocsPanel>
</DocsLayout>
