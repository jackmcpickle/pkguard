---
import { APP_NAME } from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    Note,
    SectionHeading,
} from "@/modules/docs";
import { GITHUB_URL, RELEASES_URL } from "@/lib/site";
---

<DocsLayout
    title={`Install - ${APP_NAME}`}
    description="pkguard is a Rust binary. Install it with cargo. Homebrew and prebuilt binaries are not published yet."
    current="/docs/install"
    toc={[
        { id: "cargo", label: "Cargo" },
        { id: "from-source", label: "From source" },
        { id: "binaries", label: "Prebuilt binaries" },
    ]}
>
    <DocsHeader
        eyebrow="Install"
        title="Install"
        lead="Install from the repo with cargo. Homebrew and prebuilt binaries are not published yet."
    />
    <SectionHeading id="cargo">Cargo</SectionHeading>
    <DocsBody>Requires a stable Rust toolchain.</DocsBody>
    <CodeBlock
        code={`cargo install --git ${GITHUB_URL} ${APP_NAME}\n${APP_NAME} --version`}
    />
    <SectionHeading id="from-source">From source</SectionHeading>
    <CodeBlock
        code={`git clone ${GITHUB_URL}\ncd ${APP_NAME}\ncargo install --path crates/${APP_NAME}`}
    />
    <SectionHeading id="binaries">Prebuilt binaries</SectionHeading>
    <DocsBody>
        Use cargo until Homebrew and per-platform binaries show up on the
        <a href={RELEASES_URL} class="text-ink underline" rel="noopener" target="_blank">
            releases page
        </a>.
    </DocsBody>
    <Note>
        The old npm package was named mailclad and shipped as 0.1.x. That was the Bun
        build. It does not match these docs. Settings are parsed from committed config
        files whether or not the manager binary is installed. A missing binary only
        skips the live advisory step.
    </Note>
</DocsLayout>
