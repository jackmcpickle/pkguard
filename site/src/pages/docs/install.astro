---
import { APP_NAME } from "@cli/app-name";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    Note,
    SectionHeading,
} from "@/modules/docs";
import { GITHUB_URL, RELEASES_URL } from "@/lib/site";
---

<DocsLayout
    title={`Install — ${APP_NAME}`}
    description="The CLI runs on Bun. Install it globally, or grab a standalone binary from the releases page."
    current="/docs/install"
    toc={[
        { id: "global-install", label: "Global install" },
        { id: "one-off", label: "One-off run" },
        { id: "standalone", label: "Standalone binary" },
    ]}
>
    <DocsHeader
        eyebrow="Install"
        title="Install"
        lead="The CLI runs on Bun. Install it globally, or grab a standalone binary from the releases page if you would rather not have Bun on PATH."
    />
    <SectionHeading id="global-install">Global install</SectionHeading>
    <CodeBlock
        code={`bun install -g ${APP_NAME}\n${APP_NAME} --version`}
    />
    <SectionHeading id="one-off">One-off run</SectionHeading>
    <DocsBody>No install needed for a single pass over a folder of repos.</DocsBody>
    <CodeBlock code={`bunx ${APP_NAME} audit ~/code`} />
    <SectionHeading id="standalone">Standalone binary</SectionHeading>
    <DocsBody>
        Download the binary for your platform from the
        <a href={RELEASES_URL} class="text-ink underline" rel="noopener" target="_blank">
            releases page
        </a>, mark it executable, and drop it on PATH. No Bun needed. Binaries are large
        because Bun's runtime is baked in.
    </DocsBody>
    <CodeBlock
        code={`curl -fsSL -o ${APP_NAME} \\\n  ${GITHUB_URL}/releases/latest/download/${APP_NAME}-linux-x64\nchmod +x ${APP_NAME} && mv ${APP_NAME} /usr/local/bin/`}
    />
    <Note>
        Settings are parsed from committed config files whether or not the manager binary is
        installed. A missing binary only skips the live advisory step. Also
        published:{" "}
        {`${APP_NAME}-linux-arm64, ${APP_NAME}-darwin-arm64, ${APP_NAME}-darwin-x64, ${APP_NAME}-windows-x64.exe.`}
    </Note>
</DocsLayout>
