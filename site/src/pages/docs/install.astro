---
import { APP_NAME } from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    Note,
    SectionHeading,
} from "@/modules/docs";
import {
    BREW_INSTALL,
    BREW_TAP_AND_INSTALL,
    GITHUB_URL,
    RELEASES_URL,
} from "@/lib/site";
---

<DocsLayout
    title={`Install - ${APP_NAME}`}
    description="Install pkguard with Homebrew, or build it with cargo."
    current="/docs/install"
    toc={[
        { id: "homebrew", label: "Homebrew" },
        { id: "cargo", label: "Cargo" },
        { id: "from-source", label: "From source" },
        { id: "binaries", label: "Prebuilt binaries" },
    ]}
>
    <DocsHeader
        eyebrow="Install"
        title="Install"
        lead="Homebrew is the short path on macOS and Linux. Cargo works if you already have a Rust toolchain."
    />
    <SectionHeading id="homebrew">Homebrew</SectionHeading>
    <DocsBody>
        Use the fully qualified formula name. That taps and trusts in one
        step. Homebrew 6 will not load a third-party tap until it is trusted,
        so <code>brew tap</code> alone is not enough.
    </DocsBody>
    <CodeBlock code={BREW_INSTALL} />
    <CodeBlock label="tap then trust" code={BREW_TAP_AND_INSTALL} />
    <SectionHeading id="cargo">Cargo</SectionHeading>
    <DocsBody>Requires a stable Rust toolchain.</DocsBody>
    <CodeBlock
        code={`cargo install --git ${GITHUB_URL} ${APP_NAME}\n${APP_NAME} --version`}
    />
    <SectionHeading id="from-source">From source</SectionHeading>
    <CodeBlock
        code={`git clone ${GITHUB_URL}\ncd ${APP_NAME}\ncargo install --path crates/${APP_NAME}`}
    />
    <SectionHeading id="binaries">Prebuilt binaries</SectionHeading>
    <DocsBody>
        Per-platform binaries are on the
        <a href={RELEASES_URL} class="text-ink underline" rel="noopener" target="_blank">
            releases page
        </a>
        if you prefer a download over Homebrew or cargo.
    </DocsBody>
    <Note>
        Settings are parsed from committed config files whether or not
        the manager binary is installed; a missing binary only skips the live advisory
        step.
    </Note>
</DocsLayout>
