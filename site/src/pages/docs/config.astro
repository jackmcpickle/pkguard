---
import { APP_NAME } from "@cli/app-name";
import { CONFIG_SEARCH_ORDER } from "@cli/config-sources";
import defaultConfigToml from "../../../../src/config.default.toml?raw";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    KeyValue,
    SectionHeading,
} from "@/modules/docs";
import {
    CONFIG_NAME,
    USER_CONFIG_PATH_DOCS,
    USER_CONFIG_PATH_FALLBACK,
} from "@/lib/site";
---

<DocsLayout
    title={`Config — ${APP_NAME}`}
    description="mailclad config files, search order, and the default starter."
    current="/docs/config"
    toc={[
        { id: "search-order", label: "Search order" },
        { id: "default-starter", label: "Default starter" },
    ]}
>
    <DocsHeader
        eyebrow="Guides / config"
        title="User file, then scan root, then each repo."
        lead={CONFIG_SEARCH_ORDER}
    />
    <SectionHeading id="search-order">Search order</SectionHeading>
    <KeyValue
        rows={[
            {
                key: "user",
                value: `${USER_CONFIG_PATH_DOCS}. If XDG_CONFIG_HOME is unset: ${USER_CONFIG_PATH_FALLBACK}`,
            },
            {
                key: "scan or repo",
                value: CONFIG_NAME,
            },
        ]}
    />
    <SectionHeading id="default-starter">Default starter</SectionHeading>
    <DocsBody>
        Written by <code class="font-mono text-ink">{APP_NAME} init</code>. Imported from
        <code class="font-mono text-ink">src/config.default.toml</code>.
    </DocsBody>
    <CodeBlock label={CONFIG_NAME} code={defaultConfigToml.trimEnd()} />
</DocsLayout>
