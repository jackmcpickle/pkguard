---
import { APP_NAME, MANAGER_DOCS } from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    DocsBody,
    DocsHeader,
    DocsPanel,
    KeyValue,
    SectionHeading,
} from "@/modules/docs";

const configManagers = MANAGER_DOCS.filter((manager) => manager.kind === "config");
const flagged = MANAGER_DOCS.filter((manager) => manager.kind === "python-legacy");
---

<DocsLayout
    title={`Managers - ${APP_NAME}`}
    description="Package managers pkguard scans, with binaries and native audit argv from source."
    current="/docs/managers"
    toc={[
        { id: "profiles", label: "Profiles" },
        { id: "flagged-only", label: "Flagged only" },
    ]}
>
    <DocsHeader
        eyebrow="Managers"
        title="Manager profiles"
        lead="Each row comes from the Manager enum in crates/pkguard-core/src/manager.rs. Ported means the settings checks and advisory parser are live in the Rust build. The rest are detected while those checks are ported."
    />
    <SectionHeading id="profiles">Profiles</SectionHeading>
    <DocsPanel
        footnote={`Flagged only, no live audit: ${flagged.map((manager) => manager.name).join(", ")}.`}
    >
        <table class="w-full min-w-[720px] text-left text-sm leading-5">
            <thead>
                <tr
                    class="border-b border-hairline font-mono text-xs tracking-[1.2px] text-body-mid uppercase"
                >
                    <th class="px-6 py-4 font-normal">Manager</th>
                    <th class="px-6 py-4 font-normal">Binary</th>
                    <th class="px-6 py-4 font-normal">Audit argv</th>
                    <th class="px-6 py-4 font-normal">Lockfile</th>
                    <th class="px-6 py-4 font-normal">Config</th>
                    <th class="px-6 py-4 font-normal">Ported</th>
                </tr>
            </thead>
            <tbody>
                {
                    configManagers.map((manager) => (
                        <tr class="border-b border-hairline last:border-b-0">
                            <td class="px-6 py-4 text-ink">{manager.name}</td>
                            <td class="px-6 py-4 font-mono text-body">
                                {manager.binary ?? "none"}
                            </td>
                            <td class="px-6 py-4 font-mono text-body">
                                {manager.auditArgv === null
                                    ? "OSV"
                                    : manager.auditArgv.join(" ")}
                            </td>
                            <td class="px-6 py-4 font-mono text-body-mid">
                                {manager.lockfileNames.join(", ")}
                            </td>
                            <td class="px-6 py-4 font-mono text-body-mid">
                                {manager.configNames.join(", ") || "none"}
                            </td>
                            <td class="px-6 py-4 font-mono text-body-mid">
                                {manager.ported ? "yes" : "detect only"}
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </DocsPanel>
    <SectionHeading id="flagged-only">Flagged only</SectionHeading>
    <DocsBody>
        These managers are detected and reported. They do not get a live native audit.
    </DocsBody>
    <KeyValue
        rows={flagged.map((manager) => ({
            key: manager.name,
            value: "Detected only. No live native audit.",
        }))}
    />
</DocsLayout>
