---
import { APP_NAME } from "@cli/app-name";
import { MANAGER_DOCS } from "@cli/manager-docs";
import DocsLayout from "@/layouts/DocsLayout.astro";

const configManagers = MANAGER_DOCS.filter((manager) => manager.kind === "config");
const flagged = MANAGER_DOCS.filter((manager) => manager.kind === "python-legacy");
---

<DocsLayout
  title={`Managers - ${APP_NAME}`}
  description="Package managers mailclad audits, with binaries and native audit argv from source."
  current="/docs/managers"
>
  <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-ink uppercase">
    Managers
  </p>
  <h1
    class="mt-4 text-[32px] leading-9 tracking-[-0.6px] md:text-[48px] md:leading-[48px] md:tracking-[-1.2px]"
  >
    Profiles from the CLI registry.
  </h1>
  <p class="mt-6 max-w-[60ch] text-[16px] leading-6 text-body">
    Each row is built from <code class="font-mono text-ink">src/managers</code> via
    <code class="font-mono text-ink">src/manager-docs.ts</code>.
  </p>
  <div class="mt-10 overflow-x-auto">
    <table class="w-full min-w-[720px] text-left text-[14px] leading-5">
      <thead>
        <tr class="font-mono text-[12px] tracking-[1.2px] text-body-mid uppercase">
          <th class="pb-3 font-normal">Manager</th>
          <th class="pb-3 font-normal">Binary</th>
          <th class="pb-3 font-normal">Audit argv</th>
          <th class="pb-3 font-normal">Lockfile</th>
          <th class="pb-3 font-normal">Config</th>
        </tr>
      </thead>
      <tbody>
        {
          configManagers.map((manager) => (
            <tr class="border-t border-hairline">
              <td class="py-3 text-ink">{manager.name}</td>
              <td class="py-3 font-mono text-body">
                {manager.binary ?? "none"}
              </td>
              <td class="py-3 font-mono text-body">
                {manager.auditArgv === null
                  ? "OSV"
                  : manager.auditArgv.join(" ")}
              </td>
              <td class="py-3 font-mono text-body">
                {manager.lockfileNames.join(", ")}
              </td>
              <td class="py-3 font-mono text-body">
                {manager.configNames.join(", ") || "none"}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <h2 class="mt-12 text-[20px] leading-7 text-ink">Flagged only</h2>
  <p class="mt-3 max-w-[60ch] text-[16px] leading-6 text-body">
    These managers are detected and reported. They do not get a live native audit.
  </p>
  <ul class="mt-4">
    {
      flagged.map((manager) => (
        <li class="border-t border-hairline py-4 font-mono text-[14px] leading-5 text-ink">
          {manager.name}
        </li>
      ))
    }
  </ul>
</DocsLayout>
