---
import {
    AGENTIC_CATALOG,
    APP_NAME,
    COMMANDS,
    commandSynopsis,
    flagLabel,
    type CommandHelp,
} from "@/lib/catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    KeyValue,
    Note,
    SectionHeading,
} from "@/modules/docs";

export const getStaticPaths = () =>
    COMMANDS.map((command) => ({
        params: { name: command.name },
        props: { command },
    }));

interface Props {
    command: CommandHelp;
}

const { command } = Astro.props;
const title = `${APP_NAME} ${commandSynopsis(command)}`;
const toc = [
    { id: "usage", label: "Usage" },
    ...(command.arguments.length > 0
        ? [{ id: "arguments", label: "Arguments" }]
        : []),
    { id: "options", label: "Options" },
    ...(command.name === "scan"
        ? [
              { id: "exit-codes", label: "Exit codes" },
              { id: "agentic-checks", label: "Agentic checks" },
          ]
        : []),
];
---

<DocsLayout
    title={`${title} - ${APP_NAME}`}
    description={command.summary}
    current={`/docs/commands/${command.name}`}
    toc={toc}
>
    <DocsHeader
        eyebrow={command.name}
        title={title}
        lead={command.summary}
    />
    <SectionHeading id="usage">Usage</SectionHeading>
    <CodeBlock
        code={`${APP_NAME} ${commandSynopsis(command)}${command.flags.length > 0 ? " [options]" : ""}`}
    />
    {
        command.arguments.length > 0 && (
            <>
                <SectionHeading id="arguments">Arguments</SectionHeading>
                <KeyValue
                    rows={command.arguments.map((arg) => ({
                        key: arg.required ? arg.name : `${arg.name} (optional)`,
                        value: arg.description,
                    }))}
                />
            </>
        )
    }
    <SectionHeading id="options">Options</SectionHeading>
    <KeyValue
        rows={command.flags.map((flag) => ({
            key: flagLabel(flag),
            value: flag.description,
        }))}
    />
    {
        command.name === "scan" && (
            <>
                <SectionHeading id="exit-codes">Exit codes</SectionHeading>
                <KeyValue
                    rows={[
                        { key: "0", value: "Every project passed." },
                        {
                            key: "1",
                            value: "Policy failure: settings drift or an advisory at or above the preset's gate.",
                        },
                        {
                            key: "2",
                            value: "Incomplete run: a missing binary, an audit subprocess died, or no projects were found.",
                        },
                    ]}
                />
                <Note>
                    In CI, pair --format json with your archive step. The document
                    carries schemaVersion 2 and the exit code.
                </Note>
                <SectionHeading id="agentic-checks">Agentic checks</SectionHeading>
                <DocsBody>
                    Reported by default. Turn off with [agentic] enabled = false in
                    config. These codes are the finding-code contract. Writes come
                    with the future fix command.
                </DocsBody>
                <KeyValue
                    rows={AGENTIC_CATALOG.map((check) => ({
                        key: check.code,
                        value: check.description,
                        note: check.caveat,
                    }))}
                />
            </>
        )
    }
</DocsLayout>
