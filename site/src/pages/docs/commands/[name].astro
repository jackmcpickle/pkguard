---
import { AGENTIC_CATALOG } from "@cli/agentic-catalog";
import { APP_NAME } from "@cli/app-name";
import {
    COMMANDS,
    commandSynopsis,
    flagLabel,
    type CommandHelp,
} from "@cli/cli-catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    CodeBlock,
    DocsBody,
    DocsHeader,
    KeyValue,
    Note,
    SectionHeading,
} from "@/modules/docs";

export const getStaticPaths = () =>
    COMMANDS.map((command) => ({
        params: { name: command.name },
        props: { command },
    }));

interface Props {
    command: CommandHelp;
}

const { command } = Astro.props;
const title = `${APP_NAME} ${commandSynopsis(command)}`;
const toc = [
    { id: "usage", label: "Usage" },
    ...(command.arguments.length > 0
        ? [{ id: "arguments", label: "Arguments" }]
        : []),
    { id: "options", label: "Options" },
    ...(command.name === "audit"
        ? [{ id: "agentic-checks", label: "Agentic checks" }]
        : []),
];
---

<DocsLayout
    title={`${title} — ${APP_NAME}`}
    description={command.summary}
    current={`/docs/commands/${command.name}`}
    toc={toc}
>
    <DocsHeader
        eyebrow={`Commands / ${command.name}`}
        title={title}
        lead={command.summary}
    />
    <SectionHeading id="usage">Usage</SectionHeading>
    <CodeBlock
        code={`${APP_NAME} ${commandSynopsis(command)}${command.flags.length > 0 ? " [options]" : ""}`}
    />
    {
        command.arguments.length > 0 && (
            <>
                <SectionHeading id="arguments">Arguments</SectionHeading>
                <KeyValue
                    rows={command.arguments.map((arg) => ({
                        key: arg.required ? arg.name : `${arg.name} (optional)`,
                        value: arg.description,
                    }))}
                />
            </>
        )
    }
    <SectionHeading id="options">Options</SectionHeading>
    <DocsBody>
        {command.flags.length} options in total
        {command.name === "audit" ? "; the ones you will reach for first:" : "."}
    </DocsBody>
    <KeyValue
        rows={command.flags.map((flag) => ({
            key: flagLabel(flag),
            value: flag.description,
        }))}
    />
    {
        command.name === "audit" && (
            <>
                <SectionHeading id="agentic-checks">Agentic checks</SectionHeading>
                <DocsBody>
                    Warned by default. Apply is off unless --apply-agentic. Codes come from
                    the agentic catalog in source.
                </DocsBody>
                <KeyValue
                    rows={AGENTIC_CATALOG.map((check) => ({
                        key: check.code,
                        value: check.description,
                        note: check.caveat,
                    }))}
                />
                <Note>
                    In CI, pair --json or --sarif with --report to archive the full result
                    from a pipeline.
                </Note>
            </>
        )
    }
    {
        command.name === "init" && (
            <Note>
                Use --local to write a starter config in the current directory so a run
                has the same shape on every machine and in CI.
            </Note>
        )
    }
</DocsLayout>
