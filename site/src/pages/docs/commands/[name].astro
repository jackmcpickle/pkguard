---
import { AGENTIC_CATALOG } from "@cli/agentic-catalog";
import { APP_NAME } from "@cli/app-name";
import {
  COMMANDS,
  commandSynopsis,
  flagLabel,
  type CommandHelp,
} from "@cli/cli-catalog";
import DocsLayout from "@/layouts/DocsLayout.astro";

export const getStaticPaths = () =>
  COMMANDS.map((command) => ({
    params: { name: command.name },
    props: { command },
  }));

interface Props {
  command: CommandHelp;
}

const { command } = Astro.props;
const title = `${APP_NAME} ${commandSynopsis(command)}`;
---

<DocsLayout
  title={`${title} - ${APP_NAME}`}
  description={command.summary}
  current={`/docs/commands/${command.name}`}
>
  <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-ink uppercase">
    Command
  </p>
  <h1
    class="mt-4 font-mono text-[32px] leading-9 tracking-[-0.6px] md:text-[48px] md:leading-[48px] md:tracking-[-1.2px]"
  >
    {title}
  </h1>
  <p class="mt-6 max-w-[60ch] text-[16px] leading-6 text-body">
    {command.summary}
  </p>
  {
    command.arguments.length > 0 && (
      <section class="mt-12">
        <h2 class="text-[20px] leading-7 text-ink">Arguments</h2>
        <ul class="mt-4">
          {command.arguments.map((arg) => (
            <li class="border-t border-hairline py-4">
              <p class="font-mono text-[14px] leading-5 text-ink">
                {arg.name}
                {arg.required ? "" : " (optional)"}
              </p>
              <p class="mt-2 text-[16px] leading-6 text-body">{arg.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="mt-12">
    <h2 class="text-[20px] leading-7 text-ink">Options</h2>
    <ul class="mt-4">
      {
        command.flags.map((flag) => (
          <li class="border-t border-hairline py-4">
            <p class="font-mono text-[14px] leading-5 text-ink">{flagLabel(flag)}</p>
            <p class="mt-2 text-[16px] leading-6 text-body">{flag.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
  {
    command.name === "audit" && (
      <section class="mt-12">
        <h2 class="text-[20px] leading-7 text-ink">Agentic checks</h2>
        <p class="mt-3 max-w-[60ch] text-[16px] leading-6 text-body">
          Warned by default. Apply is off unless --apply-agentic. Codes come from
          the agentic catalog in source.
        </p>
        <ul class="mt-6">
          {AGENTIC_CATALOG.map((check) => (
            <li class="border-t border-hairline py-4">
              <p class="font-mono text-[14px] leading-5 text-ink">{check.code}</p>
              <p class="mt-2 text-[16px] leading-6 text-body">{check.description}</p>
              <p class="mt-2 text-[14px] leading-5 text-body-mid">{check.caveat}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</DocsLayout>
