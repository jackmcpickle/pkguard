---
import { COMMANDS, commandSynopsis, flagLabel } from "@cli/cli-catalog";
import { APP_NAME } from "@cli/app-name";
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout
  title={`Commands - ${APP_NAME}`}
  description="Every mailclad command and flag, generated from the CLI catalog."
  current="/docs/commands"
>
  <p class="font-mono text-[14px] leading-5 tracking-[1.4px] text-ink uppercase">
    Commands
  </p>
  <h1
    class="mt-4 text-[32px] leading-9 tracking-[-0.6px] md:text-[48px] md:leading-[48px] md:tracking-[-1.2px]"
  >
    Generated from the CLI catalog.
  </h1>
  <p class="mt-6 max-w-[60ch] text-[16px] leading-6 text-body">
    These names, arguments, and flags are imported from
    <code class="font-mono text-ink">src/cli-catalog.ts</code>.
    The same data prints in <code class="font-mono text-ink">{APP_NAME} --help</code>.
  </p>
  {
    COMMANDS.map((command) => (
      <section class="mt-12 border-t border-hairline pt-8">
        <h2 class="font-mono text-[20px] leading-7 text-ink">
          <a href={`/docs/commands/${command.name}`}>
            {APP_NAME} {commandSynopsis(command)}
          </a>
        </h2>
        <p class="mt-3 text-[16px] leading-6 text-body">{command.summary}</p>
        {command.arguments.length > 0 && (
          <div class="mt-6">
            <p class="font-mono text-[12px] tracking-[1.2px] text-body-mid uppercase">
              Arguments
            </p>
            <ul class="mt-3">
              {command.arguments.map((arg) => (
                <li class="border-t border-hairline py-3">
                  <p class="font-mono text-[14px] leading-5 text-ink">
                    {arg.name}
                    {arg.required ? "" : " (optional)"}
                  </p>
                  <p class="mt-1 text-[14px] leading-5 text-body">
                    {arg.description}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="mt-6">
          <p class="font-mono text-[12px] tracking-[1.2px] text-body-mid uppercase">
            Options
          </p>
          <ul class="mt-3">
            {command.flags.map((flag) => (
              <li class="border-t border-hairline py-3">
                <p class="font-mono text-[14px] leading-5 text-ink">
                  {flagLabel(flag)}
                </p>
                <p class="mt-1 text-[14px] leading-5 text-body">
                  {flag.description}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</DocsLayout>
