---
import { COMMANDS, commandSynopsis, flagLabel } from "@cli/cli-catalog";
import { APP_NAME } from "@cli/app-name";
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
    DocsBody,
    DocsHeader,
    KeyValue,
    SectionHeading,
} from "@/modules/docs";

const toc = COMMANDS.map((command) => ({
    id: command.name,
    label: `${APP_NAME} ${command.name}`,
}));
---

<DocsLayout
    title={`Commands — ${APP_NAME}`}
    description="Every mailclad command and flag, generated from the CLI catalog."
    current="/docs/commands"
    toc={toc}
>
    <DocsHeader
        eyebrow="Commands"
        title="Generated from the CLI catalog."
        lead={`These names, arguments, and flags are imported from src/cli-catalog.ts. The same data prints in ${APP_NAME} --help.`}
    />
    {
        COMMANDS.map((command) => (
            <div class="mb-12">
                <SectionHeading id={command.name}>
                    <a href={`/docs/commands/${command.name}`} class="text-ink">
                        {APP_NAME} {commandSynopsis(command)}
                    </a>
                </SectionHeading>
                <DocsBody>{command.summary}</DocsBody>
                {command.arguments.length > 0 && (
                    <KeyValue
                        rows={command.arguments.map((arg) => ({
                            key: arg.required ? arg.name : `${arg.name} (optional)`,
                            value: arg.description,
                        }))}
                    />
                )}
                <KeyValue
                    rows={command.flags.map((flag) => ({
                        key: flagLabel(flag),
                        value: flag.description,
                    }))}
                />
            </div>
        ))
    }
</DocsLayout>
