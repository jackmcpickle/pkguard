---
import Button from "@/components/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_HOST, SITE_NAME } from "@/lib/site";
---

<BaseLayout title={`Not found — ${SITE_NAME}`} description={`That page is not on ${SITE_HOST}.`}>
    <main class="px-6 py-24">
        <div class="mx-auto max-w-[1200px]">
            <p
                class="font-mono text-[14px] leading-5 tracking-[1.4px] text-body-mid uppercase"
            >
                404
            </p>
            <h1
                class="mt-4 text-[48px] leading-[48px] font-normal tracking-[-1.2px] md:text-[72px] md:leading-[72px] md:tracking-[-1.8px]"
            >
                Page not found.
            </h1>
            <p class="mt-6 max-w-[640px] text-[18px] leading-7 text-body">
                That URL is not a docs page or the home&nbsp;page.
            </p>
            <div class="mt-12 flex flex-wrap gap-3">
                <Button href="/" variant="primary" size="lg">Home</Button>
                <Button href="/docs" size="lg">Read the docs</Button>
            </div>
        </div>
    </main>
</BaseLayout>
