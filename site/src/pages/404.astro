---
import Button from "@/components/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_HOST, SITE_NAME } from "@/lib/site";
---

<BaseLayout title={`Not found - ${SITE_NAME}`} description={`That page is not on ${SITE_HOST}.`}>
    <main class="px-4 py-24 sm:px-6">
        <div class="mx-auto max-w-[1400px]">
            <h1
                class="text-4xl leading-tight font-normal tracking-tight md:text-6xl md:leading-[1.1]"
            >
                Page not found.
            </h1>
            <p class="mt-6 max-w-[40ch] text-lg leading-7 text-body">
                That URL is not a page on this&nbsp;site.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
                <Button href="/" variant="primary" size="lg">Home</Button>
                <Button href="/docs" size="lg">Docs</Button>
            </div>
        </div>
    </main>
</BaseLayout>
