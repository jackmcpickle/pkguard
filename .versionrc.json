{
  "releaseCommitMessageFormat": "chore(release): {{currentTag}} [skip publish]",
  "packageFiles": [
    {
      "filename": "Cargo.toml",
      "updater": "scripts/cargo-version-updater.cjs"
    }
  ],
  "bumpFiles": [
    {
      "filename": "Cargo.toml",
      "updater": "scripts/cargo-version-updater.cjs"
    },
    {
      "filename": "Cargo.lock",
      "updater": "scripts/cargo-lock-updater.cjs"
    },
    {
      "filename": "site/src/generated/catalog.json",
      "updater": "scripts/catalog-version-updater.cjs"
    }
  ]
}
